# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
.utmp/
Library/
Temp/
Obj/
Build/
Logs/
UserSettings/
*.log

# By default unity supports Blender asset imports, *.blend1 blender files do not need to be commited to version control.
*.blend1
*.blend1.meta

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/Tower Defense 3D/[Mm]emoryCaptures/

# Recordings can get excessive in size
/Tower Defense 3D/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /Tower Defense 3D/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/Tower Defense 3D/[Aa]ssets/Plugins/Editor/JetBrains*
# Jetbrains Rider personal-layer settings
*.DotSettings.user

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Mono auto generated files
mono_crash.*

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# TestRunner generated files
InitTestScene*.unity*

# Addressables default ignores, before user customizations
/Tower Defense 3D/ServerData
/Tower Defense 3D/[Aa]ssets/StreamingAssets/aa*
/Tower Defense 3D/[Aa]ssets/AddressableAssetsData/link.xml*
/Tower Defense 3D/[Aa]ssets/Addressables_Temp*
# By default, Addressables content builds will generate addressables_content_state.bin
# files in platform-specific subfolders, for example:
# /Tower Defense 3D/Assets/AddressableAssetsData/OSX/addressables_content_state.bin
/Tower Defense 3D/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
/Tower Defense 3D/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/Tower Defense 3D/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/Tower Defense 3D/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/Tower Defense 3D/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes by play mode tests
/Tower Defense 3D/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

Library/
Temp/
Logs/
obj/
UserSettings/
*.DS_Store
*.sln
*.slnx
*.csproj

# ---- Large binary assets ----
# These tend to blow up repo size fast. If the team needs them versioned
# together (not just shared out-of-band), use Git LFS instead of just
# un-ignoring them.

# 3D model source files (re-exported from DCC tools — Unity only needs the
# imported result, not necessarily the source file, unless you edit meshes in-repo)
*.fbx
*.obj
*.blend
*.ma
*.mb
*.max
*.3ds
*.c4d
*.dae
*.abc
*.usd
*.usda
*.usdc
*.usdz

# Video
*.mp4
*.mov
*.avi
*.mkv
*.wmv
*.flv
*.webm
*.m4v

# Uncompressed / large audio
*.wav
*.aiff

# ML model weights (Whisper/Vosk/etc.)
*.bin
*.onnx
*.pt
*.ckpt
*.gguf

# Vosk speech models ship as a whole directory of oddly-extensioned files
# (.fst, .mdl, .dubm, .ie, .mat, .int, ...) — easier to ignore the whole
# folder than enumerate every extension Kaldi happens to use.
/Tower Defense 3D/[Aa]ssets/StreamingAssets/vosk-model-*/
